# Database
DATABASE_URL="postgresql://localhost:5432/solverify?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS + OAuth callback redirect)
FRONTEND_URL="http://127.0.0.1:5173"

# Session secret (generate a random string for production)
SESSION_SECRET="your-super-secret-session-key-change-in-production"

# Solana
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Admin (for development only - replace with your wallet address)
ADMIN_WALLET_ADDRESS=""

# X OAuth 2.0 (get from https://developer.x.com/en/portal/projects)
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://127.0.0.1:3001/api/auth/x/callback"

# Cookie domain (leave empty for localhost, set to your domain for production)
COOKIE_DOMAIN=""
