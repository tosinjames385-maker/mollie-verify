# Database
DATABASE_URL="postgresql://username:password@localhost:5432/solverify?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Solana (optional - for additional features)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Token Data API (optional - for CoinGecko / Jupiter price enrichment)
# If set, backend will use it to enrich price/marketCap - NEVER expose in frontend
# COINGECKO_API_KEY="your_coingecko_api_key_here"

# Admin (for development only)
ADMIN_WALLET_ADDRESS="your_admin_wallet_address_here"
