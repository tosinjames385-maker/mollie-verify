# =============================================================================
# Copy to `.env` locally, or paste into Vercel → Project → Settings → Environment Variables
# Never commit real secrets. `.env` is gitignored.
# =============================================================================

# --- Frontend (Vercel: add each with prefix VITE_ — required at BUILD time) ---
# Your production site URL (no trailing slash), e.g. https://mollie-verify.vercel.app
VITE_APP_URL=https://your-app.vercel.app

# Supabase (Auth / X login) — real project URL, not YOUR_PROJECT_REF
VITE_SUPABASE_URL=https://jdnfpchddosbxejezkgk.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpkbmZwY2hkZG9zYnhlamV6a2drIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk2NzM1MjYsImV4cCI6MjEwNTI0OTUyNn0.CMIMrmAuHkEV6qYMfzD2_nCY8ndxZLhQcm8-ZKRfR04

# Solana network for wallet connect: mainnet-beta | devnet | testnet
VITE_SOLANA_NETWORK=mainnet-beta

# Classroom scam demo (fake import-wallet flow + admin monitor). Pair with EDU_PHISHING_DEMO on API.
VITE_EDU_PHISHING_DEMO=false

# Optional: backend API base if you host Express separately (default in dev is /api proxy)
# VITE_API_URL=https://your-api.example.com

# --- Backend only (Railway/Render/Fly — NOT used by static Vercel frontend alone) ---
PORT=3001
NODE_ENV=production

# Classroom phishing demo API (pair with VITE_EDU_PHISHING_DEMO). Never enable on public prod without intent.
EDU_PHISHING_DEMO=false

# Must match your live frontend URL (for CORS + OAuth redirects)
FRONTEND_URL=https://your-app.vercel.app

# Random string — generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_long_random_secret

# PostgreSQL — from Supabase → Database → Connection string (pooler) or Prisma host
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Supabase server-side (same project as VITE_*; service role NEVER expose to browser)
SUPABASE_URL=https://jdnfpchddosbxejezkgk.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpkbmZwY2hkZG9zYnhlamV6a2drIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk2NzM1MjYsImV4cCI6MjEwNTI0OTUyNn0.CMIMrmAuHkEV6qYMfzD2_nCY8ndxZLhQcm8-ZKRfR04

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# X (Twitter) OAuth — optional; from developer.x.com
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://your-app.vercel.app/auth/x/callback

# Cookie domain if using API on subdomain, e.g. .yourdomain.com
# COOKIE_DOMAIN=
