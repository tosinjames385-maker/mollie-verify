generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id                  String                    @id @default(cuid())
  name                String
  symbol              String
  mintAddress         String                    @unique
  imageUrl            String?
  description         String?
  website             String?
  twitter             String?
  telegram            String?
  discord             String?
  circulatingSupply   String?
  verificationStatus  String                    @default("unverified")
  organicActivity     String                    @default("low")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  likes               TokenLike[]
  verifications       VerificationSubmission[]
  news                NewsPost[]
  riskWarnings        RiskWarning[]

  @@index([mintAddress])
  @@index([symbol])
  @@index([name])
}

model TokenLike {
  id            String   @id @default(cuid())
  tokenId       String
  walletAddress String
  createdAt     DateTime @default(now())
  token         Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, walletAddress])
  @@index([walletAddress])
  @@index([tokenId])
}

model VerificationSubmission {
  id              String   @id @default(cuid())
  tokenId         String
  submitterWallet String
  status          String   @default("pending")
  submissionType  String   @default("verification")
  reviewerWallet  String?
  reviewedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  token           Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([submitterWallet])
  @@index([status])
  @@index([createdAt])
}

model NewsPost {
  id              String   @id @default(cuid())
  tokenId         String
  url             String
  title           String?
  description     String?
  submittedBy     String
  status          String   @default("pending")
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  token           Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([submittedBy])
  @@index([status])
  @@index([createdAt])
}

model RiskWarning {
  id          String   @id @default(cuid())
  tokenId     String
  warningType String
  severity    String   @default("medium")
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  token       Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([isActive])
}

model User {
  id                String             @id @default(cuid())
  walletAddress     String?            @unique
  xUserId           String?            @unique
  xUsername         String?
  displayName       String?
  avatarUrl         String?
  email             String?
  isAdmin           Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastSeenAt        DateTime           @default(now())
  walletConnections WalletConnection[]

  @@index([walletAddress])
  @@index([xUserId])
}

model WalletConnection {
  id               String    @id @default(cuid())
  userId           String?
  walletAddress    String
  walletType       String
  chain            String    @default("solana")
  network          String    @default("mainnet-beta")
  connectedAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  disconnectedAt   DateTime?
  connectionStatus String    @default("connected") // 'connected' | 'disconnected' | 'expired'
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([walletAddress])
  @@index([userId])
  @@index([connectionStatus])
}


model BotCashOut {
  id              String   @id @default(cuid())
  amountSol       Float
  amountUsd       Float
  recipientWallet String
  status          String   @default("completed")
  txHash          String?
  notes           String?
  executedBy      String?
  createdAt       DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model BotSetting {
  id                     String   @id @default(cuid())
  isBotActive            Boolean  @default(true)
  minCashoutSol          Float    @default(5.0)
  targetCashoutWallet    String   @default("JUPbotAdminWallet111111111111111111111111")
  autoCashoutEnabled     Boolean  @default(false)
  autoTradingEnabled     Boolean  @default(true)
  slippageTolerance      Float    @default(1.0)
  maxGasFeeSol           Float    @default(0.01)
  profitTargetPct        Float    @default(25.0)
  stopLossPct            Float    @default(10.0)
  updatedAt              DateTime @updatedAt
}

model BotLog {
  id        String   @id @default(cuid())
  eventType String   // 'cash_out' | 'trade_buy' | 'trade_sell' | 'snipe' | 'system_alert'
  title     String
  details   String?
  level     String   @default("info") // 'info' | 'warn' | 'error' | 'success'
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

